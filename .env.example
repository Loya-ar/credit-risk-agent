# Copy to .env (gitignored). `python -m agent.graph` and `python -m scripts.run_eval`
# read it automatically; environment variables already set take priority.
# The Streamlit app does not read .env: use .streamlit/secrets.toml or set the variable.
# GOOGLE_API_KEY or GEMINI_API_KEY (either name works)
GOOGLE_API_KEY=
# Optional: another Gemini model (default gemini-3.5-flash-lite)
AGENT_MODEL=gemini-3.5-flash-lite
# Optional: model calls per minute (default 5 = free-tier limit; 0 = no pacing)
AGENT_RPM=5
# Optional: 'local' queries the loan-level data/agent.duckdb instead of the public tables
AGENT_DB=public
